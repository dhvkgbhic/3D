-- ========================================================
-- ★★★ 7. 科幻延迟平滑跟随 ★★★
-- ========================================================
local function getDelayedPosition(targetTime)
    if #positionHistory == 0 then return nil end
    if targetTime <= positionHistory[1].time then return positionHistory[1].pos end
    for i = 1, #positionHistory - 1 do
        local a, b = positionHistory[i], positionHistory[i + 1]
        if targetTime >= a.time and targetTime <= b.time then
            local span = b.time - a.time
            if span <= 0 then return b.pos end
            local t = (targetTime - a.time) / span
            return a.pos:Lerp(b.pos, t)
        end
    end
    return positionHistory[#positionHistory].pos
end

local function updateUIPosition(dt)
    if not isFollowingCamera then return end
    if not centerPart.Parent or not Camera then return end
    local char = LocalPlayer.Character
    if not char then positionHistory = {}; return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then positionHistory = {}; return end

    local now = os.clock()
    local targetPos = (hrp.CFrame * CFrame.new(FOLLOW_OFFSET)).Position

    table.insert(positionHistory, { time = now, pos = targetPos })
    while #positionHistory > 0 and (now - positionHistory[1].time) > (FOLLOW_DELAY + SIDE_DELAY_EXTRA) + 0.2 do
        table.remove(positionHistory, 1)
    end
    if #positionHistory > 120 then table.remove(positionHistory, 1) end

    local centerDelayedPos = getDelayedPosition(now - FOLLOW_DELAY) or targetPos
    local centerTargetCFrame = CFrame.lookAt(centerDelayedPos, Camera.CFrame.Position)
    local alphaCenter = 1 - math.exp(-dt / SMOOTH_TIME)
    centerBaseCFrame = centerBaseCFrame:Lerp(centerTargetCFrame, alphaCenter)

    local sideDelayedPos = getDelayedPosition(now - FOLLOW_DELAY - SIDE_DELAY_EXTRA) or targetPos
    local sideTargetCFrame = CFrame.lookAt(sideDelayedPos, Camera.CFrame.Position)
    local alphaSide = 1 - math.exp(-dt / SMOOTH_TIME_SIDE)
    sideBaseCFrame = sideBaseCFrame:Lerp(sideTargetCFrame, alphaSide)

    leftPart.CFrame   = sideBaseCFrame * PANEL_OFFSETS.Left
    centerPart.CFrame = centerBaseCFrame * PANEL_OFFSETS.Center
    rightPart.CFrame  = sideBaseCFrame * PANEL_OFFSETS.Right
end

RunService:BindToRenderStep("StarMeowUI", Enum.RenderPriority.Camera.Value + 1, updateUIPosition)

