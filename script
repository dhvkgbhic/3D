    _G.__StarMeow_Cleanup = nil
    pcall(function() RunService:UnbindFromRenderStep("StarMeowUI") end)
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}
    if noclipConn then pcall(function() noclipConn:Disconnect() end) end
    if musicState.currentSound then pcall(function() musicState.currentSound:Destroy() end) end
