-- ===== 9. 人物前方动态跟随（核心修改） =====
-- 更新 UI 位置：绑定在人物前方，而不是绑定在摄像机前
local function updateUIPosition()
    if not isFollowingCamera then return end
    if not uiPart.Parent or not Camera then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- 计算目标位置：人物 HumanoidRootPart 的前方（-Z轴）和上方
    local targetPos = (hrp.CFrame * CFrame.new(FOLLOW_OFFSET)).Position
    
    -- 让面板始终面向摄像机，方便玩家阅读，但位置跟随人物前方
    uiPart.CFrame = CFrame.lookAt(targetPos, Camera.CFrame.Position)
end

-- 渲染优先级 Camera.Value + 1，确保在摄像机更新之后更新 UI 位置
RunService:BindToRenderStep("StarMeowUI", Enum.RenderPriority.Camera.Value + 1, updateUIPosition)

