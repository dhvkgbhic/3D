        btnStroke.Color = Color3.fromRGB(0, 255, 150)
    else
        toggleBtn.Text = "固定在原地"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 200, 60)
        btnStroke.Color = Color3.fromRGB(255, 200, 60)
    end
end

addConn(toggleBtn.MouseButton1Click:Connect(toggleMode))

addConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        toggleMode()
    end
end))

addConn(closeBtn.MouseButton1Click:Connect(function()
    if _G.__StarMeow_Cleanup then _G.__StarMeow_Cleanup() end
end))

-- ===== 11. 角色重生处理 =====
addConn(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if noclipEnabled then setNoclip(true) end
end))

-- ===== 12. 清理函数 =====
_G.__StarMeow_Cleanup = function()
    _G.__StarMeow_Cleanup = nil
    pcall(function()
        RunService:UnbindFromRenderStep("StarMeowUI")
    end)
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}
    if noclipConn then pcall(function() noclipConn:Disconnect() end) end
    if uiPart and uiPart.Parent then
        uiPart:Destroy()
    end
    print("[⭐️星喵UI] 已关闭")
end

print("[⭐️星喵UI] 加载完成！面板已绑定在人物前方，按 T 键可切换跟随/固定。")
