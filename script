-- ===== 2. 创建 3D 面板的工具函数 =====
local function create3DPanel(name, widthPx, heightPx)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = Vector3.new(widthPx / PPS, heightPx / PPS, 0.1)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = true
    part.CastShadow = false
    part.Massless = true
    part.Parent = workspace

    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Front
    sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    sg.PixelsPerStud = PPS
    sg.LightInfluence = 0
    sg.Active = true
    sg.ZOffset = 1
    sg.Parent = part

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, widthPx, 0, heightPx)
    frame.Position = UDim2.new(0.5, -widthPx/2, 0.5, -heightPx/2)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 200, 120)
    stroke.Thickness = 2
    stroke.Transparency = 0.3
    stroke.Parent = frame

    return part, frame
end

