local function loadTab(index)
    currentTabIndex = index
    if currentTabIndex < 1 then currentTabIndex = #tabsData end
    if currentTabIndex > #tabsData then currentTabIndex = 1 end

    local tab = tabsData[currentTabIndex]
    currentTabLabel.Text = tab.name

    for _, child in ipairs(leftList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    for _, item in ipairs(tab.items) do
        local isToggle = (item.type == "toggle")
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundColor3 = isToggle and Color3.fromRGB(60, 60, 65) or Color3.fromRGB(35, 35, 40)
        btn.BorderSizePixel = 0
        btn.Text = item.name .. (isToggle and " [OFF]" or "")
        btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.AutoButtonColor = false
        btn.Parent = leftList

        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = btn
        local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(60, 60, 70); s.Thickness = 1; s.Parent = btn

        local toggleState = false

        addConn(btn.MouseEnter:Connect(function()
            if not isToggle or not toggleState then
                btn.BackgroundColor3 = isToggle and Color3.fromRGB(70, 70, 75) or Color3.fromRGB(50, 50, 60)
            end
            s.Color = Color3.fromRGB(0, 200, 120)
        end))
        addConn(btn.MouseLeave:Connect(function()
            if not isToggle or not toggleState then
                btn.BackgroundColor3 = isToggle and Color3.fromRGB(60, 60, 65) or Color3.fromRGB(35, 35, 40)
            end
            s.Color = Color3.fromRGB(60, 60, 70)
        end))

        addConn(btn.MouseButton1Click:Connect(function()
            if isToggle then
                toggleState = not toggleState
                btn.Text = item.name .. (toggleState and " [ON]" or " [OFF]")
                btn.BackgroundColor3 = toggleState and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(60, 60, 65)

                if item.musicId or item.random then
                    if toggleState then
                        stopMusic()
                        if not musicState.currentSound then
                            musicState.currentSound = Instance.new("Sound")
                            musicState.currentSound.Name = "ClientMusicPlayer"
                            musicState.currentSound.Parent = SoundService
                            musicState.currentSound.Looped = true
                        end
                        local sound = musicState.currentSound
                        sound.Volume = item.volume or 0.5

                        if item.random then
                            musicState.currentIndex = musicState.currentIndex + 1
                            if musicState.currentIndex > #item.musicIds then musicState.currentIndex = 1 end
                            sound.SoundId = "rbxassetid://" .. item.musicIds[musicState.currentIndex]
                        else
                            sound.SoundId = item.musicId
                        end
                        sound:Play()
                    else
                        stopMusic()
                    end
                elseif item.callback then
                    pcall(item.callback, toggleState)
                end
            else
                btn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
                task.delay(0.15, function()
                    if btn.Parent then btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40) end
                end)
                if item.url then
                    pcall(function()
                        local code = game:HttpGet(item.url, true)
                        loadstring(code)()
                    end)
                elseif item.callback then
                    pcall(item.callback)
                end
            end
        end))
    end
end

